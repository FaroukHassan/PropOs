# Railway fills this in when you add a PostgreSQL database
DATABASE_URL=postgresql://user:password@host:5432/railway

# Long random string (64+ characters). Required in production.
JWT_SECRET=

# Where the website is served from (comma-separated). No trailing slash.
ALLOWED_ORIGINS=https://faroukhassan.github.io,http://localhost:5173

# First-time password for the team accounts created by prisma/seed.js.
# Everyone should change it in Settings after signing in. Leave empty to get random ones in the deploy log.
SEED_PASSWORD=

NODE_ENV=production
PORT=4000
