// backend/prisma/schema.prisma
// PropOS — Sakanly edition.
// Models the way Sakanly operates:
//   Building → Unit (apartment) → Space (partition / bed / room)
//   Units run in one of three modes: PARTITIONS, HOLIDAY (nightly), LONG_TERM (annual)
//   Units are either leased from a landlord (MASTER_LEASE), managed for an owner (MANAGEMENT) or owned.
//   Money is tracked in one ledger (Transaction) plus a cheque register (Cheque).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organisation & users ─────────────────────────────────────────────────────

model Org {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  currency    String        @default("AED")
  trn         String?       // VAT registration number, printed on tax invoices
  users       User[]
  buildings   Building[]
  units       Unit[]
  spaces      Space[]
  landlords   Landlord[]
  tenants     Tenant[]
  leases      Lease[]
  bookings    Booking[]
  transactions Transaction[]
  cheques     Cheque[]
  maintenance MaintenanceRequest[]
  deals       LeasingDeal[]
  contracts   Contract[]
  documents   TenantDocument[]
  invoices    Invoice[]
  createdAt   DateTime      @default(now())
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(MANAGER)
  permissions  Json?    // non-admins: access per section, e.g. { "ledger": "view", "import": "none" }
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id])
  createdAt    DateTime @default(now())
}

// ─── Portfolio ────────────────────────────────────────────────────────────────

model Building {
  id        String   @id @default(uuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id])
  name      String
  area      String?
  city      String   @default("Dubai")
  notes     String?
  units     Unit[]
  createdAt DateTime @default(now())

  @@unique([orgId, name])
}

model Landlord {
  id        String   @id @default(uuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id])
  name      String
  phone     String?
  email     String?
  notes     String?
  units     Unit[]
  cheques   Cheque[]
  transactions Transaction[]
  createdAt DateTime @default(now())
}

model Unit {
  id            String       @id @default(uuid())
  orgId         String
  org           Org          @relation(fields: [orgId], references: [id])
  buildingId    String
  building      Building     @relation(fields: [buildingId], references: [id])
  number        String       // apartment no., e.g. "2803" or "F706"
  mode          UnitMode     @default(PARTITIONS)
  arrangement   Arrangement  @default(MASTER_LEASE)
  landlordId    String?
  landlord      Landlord?    @relation(fields: [landlordId], references: [id])
  landlordRent  Float?       // annual rent Sakanly pays the landlord (MASTER_LEASE)
  managementFee Float?       // % of income Sakanly keeps (MANAGEMENT)
  bedrooms      Int?
  bathrooms     Int?
  occupancy     Occupancy    @default(MIX)
  nightlyRate   Float?       // HOLIDAY units
  monthlyRent   Float?       // LONG_TERM units
  dewaAccount   String?
  amenities     String?
  notes         String?
  active        Boolean      @default(true)
  onWebsite     Boolean      @default(true)  // listed on sakanly.com when it has something available
  airbnbUrl     String?
  bookingUrl    String?
  spaces        Space[]
  leases        Lease[]
  bookings      Booking[]
  transactions  Transaction[]
  cheques       Cheque[]
  maintenance   MaintenanceRequest[]
  createdAt     DateTime     @default(now())

  @@unique([buildingId, number])
}

model Space {
  id            String      @id @default(uuid())
  orgId         String
  org           Org         @relation(fields: [orgId], references: [id])
  unitId        String
  unit          Unit        @relation(fields: [unitId], references: [id], onDelete: Cascade)
  code          String      // "P9", "Bed 1", "S3"
  kind          SpaceKind   @default(PARTITION)
  monthlyRate   Float
  deposit       Float       @default(0)
  capacity      Int         @default(1)
  amenities     String?
  status        SpaceStatus @default(AVAILABLE)
  availableFrom DateTime?
  notes         String?
  leases        Lease[]
  bookings      Booking[]
  transactions  Transaction[]
  createdAt     DateTime    @default(now())

  @@unique([unitId, code])
}

// ─── People & agreements ──────────────────────────────────────────────────────

model Tenant {
  id          String    @id @default(uuid())
  orgId       String
  org         Org       @relation(fields: [orgId], references: [id])
  name        String
  phone       String?
  email       String?
  nationality String?
  idNumber    String?
  secondPhone       String?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  notes       String?
  leases      Lease[]
  contracts   Contract[]
  documents   TenantDocument[]
  createdAt   DateTime  @default(now())
}

// A tenancy: one tenant in one space (partition/bed) or one whole unit (long-term)
model Lease {
  id            String      @id @default(uuid())
  orgId         String
  org           Org         @relation(fields: [orgId], references: [id])
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  unitId        String
  unit          Unit        @relation(fields: [unitId], references: [id])
  spaceId       String?
  space         Space?      @relation(fields: [spaceId], references: [id])
  startDate     DateTime
  endDate       DateTime?   // open-ended for monthly partitions
  rent          Float       // monthly rent for spaces; annual for LONG_TERM
  rentPeriod    RentPeriod  @default(MONTHLY)
  deposit       Float       @default(0)
  depositPaid   Float       @default(0)
  dueDay        Int         @default(1) // day of month rent is due
  broker        String?
  commission    Float?
  status        LeaseStatus @default(ACTIVE)
  notes         String?
  transactions  Transaction[]
  cheques       Cheque[]
  contracts     Contract[]
  createdAt     DateTime    @default(now())
}

// A sub-lease contract between Sakanly and a tenant, signed on screen or uploaded as a signed scan
model Contract {
  id               String         @id @default(uuid())
  orgId            String
  org              Org            @relation(fields: [orgId], references: [id])
  number           String         // SL-2026-0001
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  leaseId          String?
  lease            Lease?         @relation(fields: [leaseId], references: [id])
  status           ContractStatus @default(DRAFT)
  terms            Json           // snapshot of parties, premises and money at the time it was drawn up
  signToken        String         @unique
  companySignature String?        // PNG data URL
  companySignedBy  String?
  companySignedAt  DateTime?
  tenantSignature  String?
  tenantSignedName String?
  tenantSignedAt   DateTime?
  tenantSignedIp   String?
  scan             Bytes?         // signed paper copy, uploaded as a PDF
  scanName         String?
  scanUploadedAt   DateTime?
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([orgId, number])
  @@index([tenantId])
}

// Files kept in a tenant's file: Emirates ID, passport, visa…
model TenantDocument {
  id         String       @id @default(uuid())
  orgId      String
  org        Org          @relation(fields: [orgId], references: [id])
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kind       DocumentKind @default(OTHER)
  fileName   String
  mime       String
  size       Int
  data       Bytes
  number     String?      // ID / passport number
  expiresAt  DateTime?
  uploadedBy String?
  createdAt  DateTime     @default(now())

  @@index([tenantId])
}

enum DocumentKind {
  EMIRATES_ID
  PASSPORT
  VISA
  OTHER
}

// Invoices Sakanly issues (SALES) and bills it receives from suppliers (PURCHASE)
model Invoice {
  id           String        @id @default(uuid())
  orgId        String
  org          Org           @relation(fields: [orgId], references: [id])
  kind         InvoiceKind   @default(SALES)
  number       String        // INV-2026-0001 / BILL-2026-0001
  status       InvoiceStatus @default(ISSUED)
  partyType    PartyType     @default(COMPANY)
  partyName    String
  partyTrn     String?
  partyAddress String?
  partyEmail   String?
  partyPhone   String?
  tenantId     String?
  landlordId   String?
  dealId       String?
  unitId       String?
  supplierRef  String?       // the supplier's own invoice number (bills)
  issueDate    DateTime
  dueDate      DateTime?
  vatRate      Float         @default(5)
  lines        Json          // [{ description, qty, unitPrice, vat }]
  subtotal     Float
  vat          Float
  total        Float
  category     TxCategory?   // where payments go in the ledger
  notes        String?
  scan         Bytes?        // supplier's bill, as received
  scanName     String?
  scanMime     String?
  createdBy    String?
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([orgId, number])
  @@index([orgId, kind, issueDate])
}

enum InvoiceKind {
  SALES
  PURCHASE
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  VOID
}

enum PartyType {
  COMPANY
  TENANT
  GUEST
  LANDLORD
  SUPPLIER
  OTHER
}

enum ContractStatus {
  DRAFT
  SIGNED
  VOID
}

model Booking {
  id           String        @id @default(uuid())
  orgId        String
  org          Org           @relation(fields: [orgId], references: [id])
  unitId       String
  unit         Unit          @relation(fields: [unitId], references: [id])
  spaceId      String?       // a single partition booked as a holiday stay
  space        Space?        @relation(fields: [spaceId], references: [id])
  guestName    String
  guestPhone   String?
  guests       Int           @default(1)
  channel      Channel       @default(DIRECT)
  reference    String?
  checkIn      DateTime
  checkOut     DateTime
  totalAmount  Float         // what the guest pays
  channelFee   Float         @default(0) // Airbnb / Booking.com commission
  cleaningFee  Float         @default(0)
  tourismFee   Float         @default(0) // Tourism Dirham
  status       BookingStatus @default(CONFIRMED)
  notes        String?
  transactions Transaction[]
  createdAt    DateTime      @default(now())
}

// ─── Money ────────────────────────────────────────────────────────────────────

// One ledger for everything that moves money, like the monthly Transaction Log sheet
model Transaction {
  id          String        @id @default(uuid())
  orgId       String
  org         Org           @relation(fields: [orgId], references: [id])
  date        DateTime
  type        TxType
  category    TxCategory
  description String
  amount      Float
  method      PayMethod     @default(CASH)
  unitId      String?
  unit        Unit?         @relation(fields: [unitId], references: [id])
  spaceId     String?
  space       Space?        @relation(fields: [spaceId], references: [id])
  leaseId     String?
  lease       Lease?        @relation(fields: [leaseId], references: [id])
  bookingId   String?
  booking     Booking?      @relation(fields: [bookingId], references: [id])
  dealId      String?
  deal        LeasingDeal?  @relation(fields: [dealId], references: [id])
  invoiceId   String?
  invoice     Invoice?      @relation(fields: [invoiceId], references: [id])
  landlordId  String?
  landlord    Landlord?     @relation(fields: [landlordId], references: [id])
  chequeId    String?       @unique
  cheque      Cheque?       @relation(fields: [chequeId], references: [id])
  periodMonth String?       // "2026-06" — which month's rent this covers
  estimated   Boolean       @default(false)
  notes       String?
  createdBy   String?
  createdAt   DateTime      @default(now())

  @@index([orgId, date])
}

model Cheque {
  id          String        @id @default(uuid())
  orgId       String
  org         Org           @relation(fields: [orgId], references: [id])
  direction   ChequeDir     // IN = received from tenant, OUT = issued to landlord
  number      String
  bank        String?
  amount      Float
  dueDate     DateTime
  status      ChequeStatus  @default(PENDING)
  postponedTo DateTime?     // new date when a cheque is postponed
  partyName   String?       // who issued / who receives
  unitId      String?
  unit        Unit?         @relation(fields: [unitId], references: [id])
  leaseId     String?
  lease       Lease?        @relation(fields: [leaseId], references: [id])
  landlordId  String?
  landlord    Landlord?     @relation(fields: [landlordId], references: [id])
  notes       String?
  transaction Transaction?
  createdAt   DateTime      @default(now())

  @@index([orgId, dueDate])
}

model MaintenanceRequest {
  id          String              @id @default(uuid())
  orgId       String
  org         Org                 @relation(fields: [orgId], references: [id])
  unitId      String
  unit        Unit                @relation(fields: [unitId], references: [id])
  spaceCode   String?
  title       String
  description String?
  category    MaintenanceCategory @default(GENERAL)
  priority    Priority            @default(NORMAL)
  status      MaintenanceStatus   @default(OPEN)
  assignedTo  String?
  cost        Float?
  resolvedAt  DateTime?
  createdAt   DateTime            @default(now())
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  MANAGER
  VIEWER
}

enum UnitMode {
  PARTITIONS
  HOLIDAY
  LONG_TERM
}

enum Arrangement {
  MASTER_LEASE // Sakanly rents from landlord and sublets
  MANAGEMENT   // Sakanly manages for an owner for a fee
  OWNED
}

enum Occupancy {
  MIX
  LADIES
  MEN
  FAMILY
}

enum SpaceKind {
  PARTITION
  BED
  ROOM
  STUDIO
}

enum SpaceStatus {
  AVAILABLE
  RESERVED
  OCCUPIED
  NOT_READY
}

enum RentPeriod {
  MONTHLY
  YEARLY
}

enum LeaseStatus {
  ACTIVE
  NOTICE
  ENDED
}

enum Channel {
  AIRBNB
  BOOKING
  DIRECT
  OTHER
}

enum BookingStatus {
  INQUIRY
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum TxType {
  INCOME
  EXPENSE
}

enum TxCategory {
  RENT
  DEPOSIT
  BOOKING
  LEASING_COMMISSION
  OTHER_INCOME
  RENT_PAID
  DEWA
  INTERNET
  MAINTENANCE
  CLEANING
  SALARIES
  COMMISSION
  DEPOSIT_REFUND
  LICENSE
  ADMIN
  SECURITY
  FURNITURE
  OWNER_PAYOUT
  OTHER_EXPENSE
  DEAL_FUNDS_IN   // leasing: rent/deposit collected from a client on behalf of the landlord
  DEAL_FUNDS_OUT  // leasing: that money passed on to the landlord / hotel
}

enum PayMethod {
  CASH
  BANK
  CARD
  CHEQUE
  ONLINE
}

enum ChequeDir {
  IN
  OUT
}

enum ChequeStatus {
  PENDING
  POSTPONED
  DEPOSITED
  CLEARED
  BOUNCED
  REPLACED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum MaintenanceCategory {
  AC
  PLUMBING
  ELECTRICAL
  APPLIANCE
  CLEANING
  PEST
  GENERAL
}

// ─── Leasing department (brokerage deals) ──────────────────────────────────────
// Sakanly finds tenants for other people's properties and earns an agency fee.
// A deal moves LEAD → VIEWING → RESERVED → SIGNED (or CANCELLED). Money for a deal
// is in the ledger with dealId: the fee (LEASING_COMMISSION), client money held for
// the landlord (DEAL_FUNDS_IN / DEAL_FUNDS_OUT) and commissions paid (COMMISSION).
model LeasingDeal {
  id             String        @id @default(uuid())
  orgId          String
  org            Org           @relation(fields: [orgId], references: [id])
  number         Int           // Deal #12, per company
  status         DealStatus    @default(LEAD)
  contractType   ContractType  @default(YEARLY)
  // client (the tenant we found)
  clientName     String
  clientPhone    String?
  clientEmail    String?
  clientNationality String?
  source         String?       // Bayut, Property Finder, Instagram, referral…
  // property
  property       String?       // building / project name
  unitNo         String?
  area           String?
  unitType       String?       // studio, 1BR, 2BR…
  landlordName   String?       // owner, agency or hotel
  landlordPhone  String?
  // terms
  moveIn         DateTime?
  months         Int?          // contract length
  rent           Float?        // monthly rent (short term) or annual rent (yearly)
  cheques        Int?          // number of cheques (yearly)
  deposit        Float?
  fee            Float?        // Sakanly's agency fee / commission due from the deal
  agent          String?       // who handled it
  agentCommission  Float?      // owed to our agent
  brokerName     String?       // outside broker, if shared
  brokerCommission Float?
  viewingAt      DateTime?
  followUpAt     DateTime?
  signedAt       DateTime?
  closedAt       DateTime?     // signed or cancelled
  lostReason     String?
  notes          String?
  transactions   Transaction[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([orgId, number])
  @@index([orgId, status])
}

enum DealStatus {
  LEAD
  VIEWING
  RESERVED
  SIGNED
  CANCELLED
}

enum ContractType {
  SHORT_TERM // monthly, 1–11 months
  YEARLY
}
